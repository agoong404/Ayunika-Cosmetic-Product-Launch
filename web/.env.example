# BFF situs publik. Isi di Railway / .env lokal. JANGAN commit nilai asli.
MCP_URL=https://ayunika-cosmetic-product-launch-production.up.railway.app/mcp
MCP_TOKEN=isi-token-transport-64-hex

# Port yang didengarkan BFF. Railway menyuntik PORT; biarkan kosong secara lokal.
PORT=8080

# Penjelas (opsi C) — OPSIONAL. Kosongkan ketiganya dan fitur chat disembunyikan.
# Harus API bergaya OpenAI: POST {BASE_URL}/chat/completions
# Contoh Hunyuan / DeepSeek / OpenAI: isi base URL tanpa /chat/completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
