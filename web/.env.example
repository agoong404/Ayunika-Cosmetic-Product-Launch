# BFF situs publik. Isi di Railway / .env lokal. JANGAN commit nilai asli.
# Domain MCP service yang aktif. Domain lama
# (ayunika-cosmetic-product-launch-production.up.railway.app) sudah tidak melayani —
# /health di sana 404. Jangan hardcode domain di image; lihat web/Dockerfile.
MCP_URL=https://mcp-service-ayunika-production.up.railway.app/mcp
MCP_TOKEN=isi-token-transport-64-hex

# Port yang didengarkan BFF. Railway menyuntik PORT; biarkan kosong secara lokal.
PORT=8080
