# Contoh konfigurasi LLM untuk agents/.
# Salin jadi .env, isi nilainya, lalu muat ke environment sebelum menjalankan agent.
#
#   bash       : set -a && source agents/.env && set +a
#   PowerShell : Get-Content agents/.env | ForEach-Object { ... }   (atau pakai dotenv)
#
# JANGAN commit file .env. Yang di-commit hanya contoh ini.

# ---------------------------------------------------------------- pilih provider
# Preset yang sudah dikenal: openai | deepseek | tokenhub | ollama
# Kosongkan bila memakai provider lain (isi LLM_BASE_URL manual).
LLM_PROVIDER=deepseek

# ---------------------------------------------------------------- DeepSeek (murah, uji dulu)
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...

# ---------------------------------------------------------------- Tencent TokenHub
# Catatan: base URL berakhiran /plan/v3, BUKAN /v1. Format request-nya belum
# terverifikasi sebagai OpenAI-compatible — uji dengan `python -m agents.llm.client --ping`
# sebelum memakainya untuk 40 run. Bila 404, coba LLM_CHAT_PATH lain.
# LLM_BASE_URL=https://tokenhub.tencentmaas.com/plan/v3
# LLM_MODEL=deepseek-v4-flash-202605
# LLM_API_KEY=...

# ---------------------------------------------------------------- OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# ---------------------------------------------------------------- Ollama (lokal, tanpa key)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# ---------------------------------------------------------------- batas & perilaku
LLM_TIMEOUT=30
# Satu konten maksimal 9 panggilan (3 agent x 3 iterasi). Lebih dari ini = bug.
LLM_MAX_CALLS=9
LLM_TEMPERATURE=0.4
# Override bila provider memakai path berbeda, mis. /v1/chat/completions
# LLM_CHAT_PATH=/chat/completions

# ---------------------------------------------------------------- agent rekan tim
# Set untuk memakai Planner/Writer buatan tim lain:
# TEAM_AGENTS_MODULE=tim.agents
