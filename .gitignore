dataset_halal/shared/contacts.csv

# ---- materi pihak ketiga ----
Tencent_Cloud_Hackathon_Indonesia_2026_Handbook.pdf
# seluruh src/: ekstrak teks dari materi pihak ketiga, turunan dari PDF di atas
research/src/

