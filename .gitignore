# Demo mp4 + pembangunnya (capture/build/transcript) tidak ikut repo; storyboard
# di submission_templates/ mendokumentasikan prosesnya.
video/
my-video/

# ---- dataset panitia (bukan milik kami untuk dipublikasikan) ----
dataset/

# ---- folder karantina sementara: jangan ikut repo ----
trash/

# ---- sisa build ----
__pycache__/
*.pyc
node_modules/
submission_templates/shots/_html/
*.log

# ---- lapisan MCP ----
# venv memuat SDK, bukan bagian repo.
.venv/
# kunci approval manusia. Kalau ini ikut ter-commit, gerbang approval jadi
# formalitas: siapa pun yang bisa membaca repo bisa menyetujui konten.
.approval_key
# registri hash kunci per approver (JSON {"Nama": "<sha256>"}). Hash bukan
# rahasia sebesar kunci aslinya, tetap tidak masuk repo: isinya berubah tiap
# rotasi dan bukan bagian submission.
.approver_keys

# ---- folder & file submission/docs/media: tidak diikutkan ke repo ----
diagram/
